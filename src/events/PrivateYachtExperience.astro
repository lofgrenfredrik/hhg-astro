---
import { getCollection } from "astro:content";
import EventCard from "../components/EventCard.astro";

const event3 = await getCollection("event3");

const eventData = {
  title: "Private Yacht Experience",
  description:
    "An exclusive sunset cruise through Dubai Marina aboard a luxury superyacht. Guests enjoyed premium champagne service, gourmet catering, and breathtaking views of the iconic skyline.",
