---
import { getCollection } from "astro:content";
import EventCard from "../components/EventCard.astro";

const event1 = await getCollection("event1");

const eventData = {
  title: "Annual Gala Dinner",
  description:
    "An exquisite evening of fine dining and entertainment at the Grand Ballroom. Our signature event brought together distinguished guests from across the globe for an unforgettable celebration of luxury hospitality.",
  date: "December 2024",
  location: "Dubai",
  images: event1,
};
---

<EventCard {...eventData} />
