---
import "../global.css";
import { Font } from "astro:assets";
import type { OpenGraph } from "@astrolib/seo";
import { AstroSeo } from "@astrolib/seo";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
  openGraph?: OpenGraph;
}

const { title, description, openGraph } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Font cssVariable="--font-unna" preload />
    <Font cssVariable="--font-header" preload />
    <Font cssVariable="--font-body" preload />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Essential Meta Tags for Accessibility & SEO -->
    <meta name="author" content="Henx Hospitality Group" />
    <meta
      name="keywords"
      content="luxury hospitality, premium services, Stockholm, Dubai, events, catering"
    />
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <!-- Accessibility Meta Tags -->
    <meta name="theme-color" content="rgb(2, 2, 2)" />
    <meta name="color-scheme" content="dark" />
    <meta
      http-equiv="content-security-policy"
      content="default-src 'self'; img-src 'self' https://res.cloudinary.com; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    />
    <AstroSeo
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={openGraph}
    />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
