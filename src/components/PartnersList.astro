---
import { getCollection } from "astro:content";
import { CldImage } from "astro-cloudinary";

const partners = await getCollection("partners");
---

<div class="partners-grid" role="list" aria-label="Partner companies list">
  {
    partners.map((partner) => (
      <div class="partner-logo" role="listitem">
        <CldImage
          src={partner.data.public_id}
          alt={`${partner.data.context?.custom?.alt || `${partner.data.display_name} logo`}`}
          title={`${partner.data.context?.custom?.caption || `Official logo for ${partner.data.display_name}`}`}
          loading="lazy"
          width={300}
          height={300}
          crop={{
            height: 300,
            type: "fit",
          }}
        />
      </div>
    ))
  }
</div>

<style>
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
    align-items: center;
    justify-items: center;
  }

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--foreground);
    padding: 0.5rem 2.5rem;
    border-radius: 2%;
  }
</style>
