---
import Divider from "./Divider.astro";
---

<section role="banner" aria-labelledby="hero-title">
  <h1 id="hero-title">Henx Hospitality Group</h1>
  <Divider>
  <p>
    Henx Hospitality Group is a luxury international hospitality group based in
    Stockholm and operating in Dubai. HHG offers an exquisite range of premium
    hospitality services.
  </p>

  <div class="scroll-indicator">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    text-align: center;
    gap: 2rem;
  }

  h1 {
    font-size: 3rem;
    text-wrap: balanced;
    font-family: var(--font-unna)
  }

  p {
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
    max-width: 42rem;
    line-height: 1.6;
  }

  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-block: 2.5rem;
  }

  .divider-line {
    height: 1px;
    width: 4rem;
    background-color: var(--primary-light);
    opacity: 0.6;
  }

  .divider-diamond {
    width: 0.65rem;
    height: 0.65rem;
    transform: rotate(45deg);
    border: 2px solid var(--primary-light);
    opacity: 0.6;
    box-sizing: border-box;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .scroll-line {
    width: 1px; /* w-px */
    height: 4rem; /* h-16 */
    background: linear-gradient(
      to bottom,
      transparent,
      var(--primary-light) 60%,
      rgba(0, 0, 0, 0.15) 100%
    );
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (min-width: 37.5rem) {
    h1 {
      font-size: 4rem;
    }
    p {
      font-size: 1.25rem;
  }

  @media (min-width: 64rem) {
    h1 {
      font-size: 7rem;
    }
  }
</style>
