---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  images: Array<string>;
  date?: string;
  location?: string;
}

const { title, description, images, date, location } = Astro.props;
---

<article data-active-image="0">
  {/* Main Image */}
  <div class="image-container">
    {images.map((image, index) => (
      <Image
        src={image}
        alt={title}
        width={600}
        height={400}
        sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 600px"
        format="avif"
        loading={index === 0 ? "eager" : "lazy"}
        class="main-image"
        data-image-index={index}
      />
    ))}
    <div class="gradient-overlay" />

    {/* Image navigation dots */}
    {images.length > 1 && (
      <div class="image-dots">
        {images.map((_, index) => (
          <button
            class="image-dot"
            data-active={index === 0}
            data-image-index={index}
            aria-label={`View image ${index + 1}`}
          />
        ))}
      </div>
    )}
  </div>

  {/* Thumbnail Gallery */}
  {images.length > 1 && (
    <div class="thumbnails-wrapper" role="region" aria-label="Image thumbnails, use arrow keys to navigate, enter or space to select">
      <div class="thumbnails">
        {images.map((image, index) => (
          <button
            class="thumbnail"
            data-active={index === 0}
            data-image-index={index}
            aria-label={`${title} - Image ${index + 1}`}
          >
              <Image
                src={image}
                alt={`${title} - Image ${index + 1}`}
                width={200}
                height={200}
                format="avif"
                loading="lazy"
              />
          </button>
        ))}
      </div>
    </div>
  )}

  {/* Event Details */}
  <div class="event-details">
    {(date || location) && (
      <div class="event-meta">
        {date && <span>{date}</span>}
        {date && location && <span class="separator">—</span>}
        {location && <span>{location}</span>}
      </div>
    )}

    <h3>{title}</h3>

    {description && (
      <p>{description}</p>
    )}
  </div>
</article>

<script>
  function scrollThumbnailIntoView(index: number, article: HTMLElement) {
    const thumbnail = article.querySelector(`.thumbnail[data-image-index="${index}"]`);

    if (thumbnail) {
      thumbnail.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center'
      });
    }
  }

  function setActiveImage(index: number, article: HTMLElement) {
    const dots = article.querySelectorAll('.image-dot');
    const thumbnails = article.querySelectorAll('.thumbnail');

    // Update active image state
    article.setAttribute('data-active-image', index.toString());

    // Update all interactive elements with dataset properties
    dots.forEach((dot, i) => {
      (dot as HTMLElement).dataset.active = (i === index).toString();
    });

    thumbnails.forEach((thumb, i) => {
      (thumb as HTMLElement).dataset.active = (i === index).toString();
    });

    // Auto-scroll thumbnail into view
    scrollThumbnailIntoView(index, article);
  }

  // Initialize each EventCard instance with component-scoped event delegation
  document.addEventListener('DOMContentLoaded', () => {
    const eventCards = document.querySelectorAll('article');

    eventCards.forEach(article => {
      // Click event delegation for dots and thumbnails
      article.addEventListener('click', (e) => {
        const clickedElement = (e.target as HTMLElement).closest('.image-dot, .thumbnail');

        if (clickedElement) {
          const imageIndex = parseInt((clickedElement as HTMLElement).dataset.imageIndex || '0');
          setActiveImage(imageIndex, article);
        }
      });

      // Component-scoped keyboard navigation
      article.addEventListener('keydown', (e) => {
        const focusedElement = document.activeElement as HTMLElement;

        // Only handle keyboard navigation if the focused element is within this article
        if (article.contains(focusedElement) && focusedElement?.classList.contains('thumbnail')) {
          const currentIndex = parseInt(focusedElement.dataset.imageIndex || '0');
          const allThumbnails = article.querySelectorAll('.thumbnail');

          if (e.key === 'ArrowLeft' && currentIndex > 0 && allThumbnails) {
            e.preventDefault();
            const prevThumbnail = allThumbnails[currentIndex - 1] as HTMLElement;
            prevThumbnail?.focus();
            prevThumbnail?.click();
          } else if (e.key === 'ArrowRight' && allThumbnails && currentIndex < allThumbnails.length - 1) {
            e.preventDefault();
            const nextThumbnail = allThumbnails[currentIndex + 1] as HTMLElement;
            nextThumbnail?.focus();
            nextThumbnail?.click();
          }
        }
      });
    });
  });
</script>

<style>
  article {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    overflow: hidden;
  }

  .image-container {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    margin-bottom: 1rem;
    background-color: var(--border);
    max-width: 100%;
  }

  .image-container .main-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.7s ease;
    opacity: 0;
  }

  /* Hide all images by default, show only active one */
  article[data-active-image] .main-image[data-image-index] {
    opacity: 0;
  }

  /* Show active image with specific selectors */
  article[data-active-image="0"] .main-image[data-image-index="0"],
  article[data-active-image="1"] .main-image[data-image-index="1"],
  article[data-active-image="2"] .main-image[data-image-index="2"],
  article[data-active-image="3"] .main-image[data-image-index="3"],
  article[data-active-image="4"] .main-image[data-image-index="4"],
  article[data-active-image="5"] .main-image[data-image-index="5"],
  article[data-active-image="6"] .main-image[data-image-index="6"],
  article[data-active-image="7"] .main-image[data-image-index="7"],
  article[data-active-image="8"] .main-image[data-image-index="8"],
  article[data-active-image="9"] .main-image[data-image-index="9"] {
    opacity: 1;
  }

  article:hover .main-image {
    transform: scale(1.05);
  }

  .gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(2, 2, 2, 0.6), transparent, transparent);
  }

  .image-dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .image-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: calc(infinity * 1px);
    border: none;
    background-color: rgb(238, 238, 238, 0.4);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .image-dot:hover {
    background-color: rgb(238, 238, 238, 0.6);
  }

  .image-dot[data-active="true"] {
    background-color: var(--primary);
    width: 1.5rem;
  }

  .thumbnails-wrapper {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 1.5rem;
    position: relative;
    padding: 0.5rem 0;
  }

  .thumbnails-wrapper::-webkit-scrollbar {
    height: 6px;
  }

  .thumbnails-wrapper::-webkit-scrollbar-track {
    background: transparent;
  }

  .thumbnails-wrapper::-webkit-scrollbar-thumb {
    background-color: var(--border);
    border-radius: 3px;
  }

  .thumbnails {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 0.5rem;
    min-width: max-content;
    scroll-snap-type: x mandatory;
  }

  .thumbnail {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: none;
    background: none;
    cursor: pointer;
    transition: all 0.3s ease;
    scroll-snap-align: start;
    flex-shrink: 0;
    flex-basis: 85px;
    width: 85px;
    min-height: 85px;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail[data-active="true"] {
    border: 2px solid var(--primary);
  }

  .thumbnail:not([data-active="true"]) {
    opacity: 0.6;
  }

  .thumbnail:hover {
    opacity: 1;
  }

  .event-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.0625rem;
    text-transform: uppercase;
    color: var(--primary);
  }

  .separator {
    color: var(--muted-foreground);
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 300;
    margin: 0;
  }

  p {
    line-height: 1.75;
    margin: 0;
  }

  /* Focus management for accessibility */
  .image-dot:focus,
  .thumbnail:focus {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* Scroll indicators for visual polish */
  .thumbnails-wrapper::before,
  .thumbnails-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 20px;
    pointer-events: none;
    z-index: 1;
  }

  .thumbnails-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--background), transparent);
  }

  .thumbnails-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--background), transparent);
  }

  /* Tablet and up (768px) */
  @media (min-width: 48rem) {
    .image-container {
      aspect-ratio: 4/3;
      margin-bottom: 1.5rem;
    }

    .thumbnails-wrapper {
      margin-bottom: 1.5rem;
    }

    .event-details {
      gap: 1rem;
    }

    h3 {
      font-size: 2rem;
    }
  }

  /* Desktop and up (1024px) */
  @media (min-width: 64rem) {
    .thumbnail {
      flex-basis: 100px;
      width: 100px;
      min-height: 100px;
    }

    h3 {
      font-size: 2.5rem;
    }
  }

  /* Large desktop and up (1280px) */
  @media (min-width: 80rem) {
    h3 {
      font-size: 3rem;
    }
  }

  /* Respect user motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .image-container .main-image {
      transition-duration: 0.01ms;
    }

    .image-dot,
    .thumbnail {
      transition-duration: 0.01ms;
    }

    .thumbnails-wrapper {
      scroll-behavior: auto;
    }

    .thumbnail {
      scroll-snap-align: unset;
    }

    .thumbnails {
      scroll-snap-type: unset;
    }

    article:hover .main-image {
      transform: none;
    }
  }
</style>
