---
import { Picture } from "astro:assets";
import LogoText from "../assets/LogoText.png";
---

<footer role="contentinfo">
  <div class="max-width-wrapper container">
    <div class="logo-container">
      <Picture src={LogoText} alt="Henx Hospitality Group" />
      <p class="text-body">
        Luxury international hospitality group delivering premium services with
        Nordic elegance.
      </p>
    </div>

    <div class="contact-sections">
      <div class="contact-container">
        <h3>Follow</h3>
        <div class="contact-socials">
          <a
            href="https://www.facebook.com/Henxhospitalitygroup"
            target="_blank"
            rel="noopener noreferrer"
            class="link-primary"
            aria-label="Follow Henx Hospitality Group on Facebook"
          >
            <span>Facebook</span>
          </a>
          <a
            href="https://www.instagram.com/henxhospitalitygroup"
            target="_blank"
            rel="noopener noreferrer"
            class="link-primary"
            aria-label="Follow Henx Hospitality Group on Instagram"
          >
            <span>Instagram</span>
          </a>
          <a
            href="https://www.linkedin.com/company/henx-hospitality-group"
            target="_blank"
            rel="noopener noreferrer"
            class="link-primary"
            aria-label="Connect with Henx Hospitality Group on LinkedIn"
          >
            <span>LinkedIn</span>
          </a>
        </div>
      </div>

      <div class="contact-container">
        <h3>Enquiries</h3>
        <div class="contact-info">
          <p>Email</p>
          <a href="mailto:contact@henxhospitality.com" class="link-primary"
            aria-label="Email Henx Hospitality Group at contact@henxhospitality.com"
            >contact@henxhospitality.com</a
          >
        </div>
        <div class="contact-info">
          <p>Phone</p>
          <a href="tel:+46701234567" class="link-primary"
            aria-label="Call Henx Hospitality Group at +46 70 123 45 67">+46 70 123 45 67</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<div class="copyright" role="contentinfo">
  <p>
    © {new Date().getFullYear()} Henx Hospitality Group. All rights reserved.
  </p>
</div>

<style>
  footer {
    border-top: 1px solid var(--border-color);
    margin-top: 4rem;
    padding-block: 5rem;
  }

  img {
    height: 78px;
    width: auto;
  }

  .container {
    display: grid;
    gap: 6rem;
  }

  .logo-container p {
    margin-top: 2rem;
  }

  .contact-sections {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
  }

  .contact-socials {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-socials .link-primary {
    border-left: 1px solid var(--primary);
    padding-left: 0.75rem;
    border-width: 1px;
    transition:
      border-width 0.3s ease-in-out,
      transform 0.3s ease-in-out;
  }

  .contact-socials .link-primary:hover {
    transform: scale(1.05);
    border-width: 3px;
  }

  .contact-container h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .contact-info + .contact-info {
    margin-top: 1.5rem;
  }

  .contact-info p {
    margin-bottom: 0.5rem;
    color: var(--primary);
  }

  .contact-info .link-primary {
    display: block;
    margin-top: 0.25rem;
  }

  .copyright {
    max-width: var(--max-width);
    margin: 0 auto;
    margin-top: 4rem;
    padding-block: 1.5rem;
    font-size: 0.75rem;
  }

  @media (min-width: 768px) {
    .container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-sections {
      flex-direction: row;
      gap: 2rem;
    }
  }
</style>
