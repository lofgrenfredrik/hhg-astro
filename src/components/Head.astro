---
import "../global.css";
import { Font } from "astro:assets";
---

<Font cssVariable="--font-unna" preload />
<Font cssVariable="--font-open-sans" preload />

<!-- Essential Meta Tags for Accessibility & SEO -->
<meta name="description" content="Henx Hospitality Group - Luxury international hospitality group delivering premium services with Nordic elegance in Stockholm and Dubai." />
<meta name="author" content="Henx Hospitality Group" />
<meta name="keywords" content="luxury hospitality, premium services, Stockholm, Dubai, events, catering" />

<!-- Open Graph Meta Tags -->
<meta property="og:title" content="Henx Hospitality Group - Luxury Hospitality" />
<meta property="og:description" content="Luxury international hospitality group delivering premium services with Nordic elegance." />
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />

<!-- Accessibility Meta Tags -->
<meta name="theme-color" content="rgb(2, 2, 2)" />
<meta name="color-scheme" content="dark" />
