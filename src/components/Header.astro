---
import { Picture } from "astro:assets";
import LogoSimple from "../assets/LogoSimple.png";
---

<header>
  <div class="max-width-wrapper">
    <a href="/" aria-label="Henx Hospitality Group home page">
      <Picture
        src={LogoSimple}
        alt="Henx Hospitality Group Logo"
        priority
        formats={["avif", "webp"]}
      />
    </a>
    <nav aria-label="Main navigation">
      <a href="/" class="link-primary" aria-label="Home" aria-current="page"
        >Home</a
      >
      <a href="/events" class="link-primary" aria-label="Events page">Events</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    border-bottom: 1px solid var(--border-color);
    z-index: 100;
    background-color: var(--background);
  }

  .max-width-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
    padding-inline: 2rem;
  }

  img {
    height: 2.2rem;
    width: auto;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  .link-primary {
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 1px;
  }

  @media (min-width: 37.5rem) {
    img {
      height: 2.8rem;
    }
  }

  @media (min-width: 75rem) {
    header div {
      padding-inline: 0rem;
    }
  }
</style>
