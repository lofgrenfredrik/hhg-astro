---
import { Picture } from "astro:assets";
import LogoSimple from "../assets/LogoSimple.png";
---

<header>
  <div class="max-width-wrapper">
    <a href="/">
      <Picture
        src={LogoSimple}
        alt="HHG Logo"
        priority
        formats={["avif", "webp"]}
      />
    </a>
    <nav>
      <a href="/" class="link-primary">Home</a>
      <a href="/events" class="link-primary">Events</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    border-bottom: 1px solid var(--border-color);
    z-index: 100;
    background-color: var(--background);
  }

  .max-width-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
    padding-inline: 2rem;
  }

  img {
    height: 35px;
    width: auto;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  .link-primary {
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  @media (min-width: 600px) {
    img {
      height: 45px;
    }
  }

  @media (min-width: 1200px) {
    header div {
      padding-inline: 0rem;
    }
  }
</style>
