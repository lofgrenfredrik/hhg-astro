---
import Divider from "../components/Divider.astro";
import AnnualGalaDinner from "../events/AnnualGalaDinner.astro";
import NordicLeadershipSummit from "../events/NordicLeadershipSummit.astro";
import PrivateYachtExperience from "../events/PrivateYachtExperience.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Henx Hospitality Group Events"
  description="Explore the events and experiences offered by Henx Hospitality Group."
  openGraph={{
    title: "Henx Hospitality Group Events",
    type: "website",
    url: "https://henxhospitality.com/events",
    description:
      "Explore the events and experiences offered by Henx Hospitality Group.",
    site_name: "Henx Hospitality Group",
    images: [
      {
        url: "https://henxhospitality.com/og-image.png",
        width: 1200,
        height: 630,
        alt: "Henx Hospitality Group Events",
      },
    ],
  }}
>
  <section class="max-width-wrapper first-section">
    <span class="pre-title">Portfolio</span>
    <h1 class="">Executed Events</h1>
    <Divider />
    <p>
      A curated selection of our most distinguished events, showcasing the
      exceptional experiences we create for our valued clients.
    </p>
  </section>

  <section class="max-width-wrapper event-grid">
    <AnnualGalaDinner />
    <PrivateYachtExperience />
    <NordicLeadershipSummit />
  </section>
</Layout>

<style>
  .first-section {
    padding-top: 9rem;
  }

  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-bottom: 4rem;
  }

  section + section {
    margin-top: 8rem;
  }

  h1 {
    font-size: 5rem;
    text-align: center;
  }

  p {
    max-width: 42rem;
    text-align: center;
    font-size: 1.125rem;
  }

  .event-grid {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    gap: 5rem;
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .event-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
