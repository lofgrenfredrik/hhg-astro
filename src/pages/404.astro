---
import Divider from "../components/Divider.astro";
import Layout from "../layouts/Layout.astro";
---


<Layout>
  <section>
    <p class="error-code">404</p>
    <Divider />
    <h1>Page Not Found</h1>
    <p>The page you are looking for may have been moved, removed, or is temporarily unavailable.</p>

    <a href="/" class="return-home-link">
      <span class="return-home-line"/>
      <span>Return to Home</span>
      <span class="return-home-line"/>
    </a>
  </section>
</Layout>


<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    text-align: center;
    gap: 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .error-code {
    font-family: var(--font-unna);
    line-height: 1;
    font-size: 12rem;
    font-weight: bold;
    color: var(--primary);
  }

  h1 {
    font-size: 3rem;
  }

  p {
    font-size: 1.25rem;
    max-width: 35rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-foreground);
    transition: all 0.5s ease-in-out;
    margin-top: 3rem;
  }

  a:hover {
    color: var(--foreground);
    transform: scale(1.05);
  }

  .return-home-line {
    display: block;
    width: 2rem;
    height: 1px;
    background-color: color-mix(in oklab, var(--primary), transparent 60%);
    transition: all 0.3s ease-in-out;
  }

  a:hover .return-home-line {
    width: 3.5rem;
    background-color: var(--primary);
  }
</style>
